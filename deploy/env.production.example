# Production environment for sharekeep.xyz — copy to /opt/fileshare/.env on the VPS.
#
# Generate secrets ON THE HOST and never reuse a development value (Rules.md §3, §7):
#
#   openssl rand -base64 48        # FILESHARE_JWT_SECRET (must be >= 32 bytes)
#   openssl rand -base64 32        # FILESHARE_POSTGRES_PASSWORD
#
# The API refuses to start in production if any of the settings below is wrong in a way
# that would fail quietly later (app/core/config.py::production_configuration_errors), so
# a mistake here shows up as a container that will not come up, naming the variable.
#
# chmod 600 this file. It never leaves the host.

FILESHARE_ENVIRONMENT=production
FILESHARE_LOG_LEVEL=INFO

# --- Database (container-internal; the port is never published in production) ---
FILESHARE_POSTGRES_USER=fileshare
FILESHARE_POSTGRES_PASSWORD=
FILESHARE_POSTGRES_DB=fileshare

# --- Auth ---
FILESHARE_JWT_SECRET=
FILESHARE_COOKIE_SECURE=true
# Unset, deliberately: auth cookies stay host-only on the API host, and the CSRF cookie
# cannot use its __Host- prefix with a Domain attribute (Architecture.md §4.0).
# FILESHARE_COOKIE_DOMAIN=

# --- Proxies (Architecture.md §4.4) ---
# client -> Cloudflare -> Caddy -> container. Cloudflare writes the visitor's address and
# Caddy appends Cloudflare's edge address, so the client is two entries from the right.
# This number is only honest while port 443 is closed to everything but Cloudflare
# (deploy/02-firewall.sh).
FILESHARE_TRUSTED_PROXY_HOPS=2

# --- Public origins ---
# Every emailed link is built from FRONTEND_ORIGIN, and CORS admits exactly it.
FILESHARE_FRONTEND_ORIGIN=https://sharekeep.xyz
# Baked into the frontend bundle at BUILD time (a runtime value is ignored by browser
# code — Architecture.md §15), so changing it needs a rebuild, not a restart.
FILESHARE_PUBLIC_API_BASE_URL=https://api.sharekeep.xyz
# Also a build argument: named in the frontend's CSP connect-src, because upload parts go
# browser-direct to storage.
FILESHARE_PUBLIC_STORAGE_ORIGIN=https://<project_ref>.storage.supabase.co

# --- Sign-up (Architecture.md §4.0) ---
# Invite-only: addresses here may create an account without an invitation. Comma
# separated; may be left empty, which means invitation-only.
FILESHARE_SIGNUP_ALLOWLIST=

# --- Object storage (Architecture.md §8) ---
# A bucket of its own, separate from development. An object is only an orphan relative to
# one database, so a cleanup run from a local stack sharing this bucket would delete every
# production file.
FILESHARE_SUPABASE_URL=https://<project_ref>.supabase.co
FILESHARE_SUPABASE_SERVICE_ROLE_KEY=
FILESHARE_SUPABASE_STORAGE_BUCKET=fileshare-prod
FILESHARE_SUPABASE_REGION=ap-south-1
FILESHARE_SUPABASE_S3_ACCESS_KEY_ID=
FILESHARE_SUPABASE_S3_SECRET_ACCESS_KEY=

# --- Backups (deploy/04-backup.sh) ---
FILESHARE_BACKUP_BUCKET=fileshare-backups
# The age PUBLIC key. The private key stays off this host, so neither a compromised VPS
# nor the storage keys can read a backup.
FILESHARE_BACKUP_AGE_RECIPIENT=

# --- Malware scanning (Architecture.md §3) ---
FILESHARE_SCANNING_ENABLED=true
FILESHARE_VIRUSTOTAL_API_KEY=
# Off by default and left off: free-tier submissions are shared with the VirusTotal
# community, which would publish a user's private file (Architecture.md §3b).
FILESHARE_VIRUSTOTAL_SUBMIT_UNKNOWN_FILES=false

# --- Email (Architecture.md §5c) ---
FILESHARE_RESEND_API_KEY=
FILESHARE_RESEND_FROM_EMAIL=notifications@mail.sharekeep.xyz
# MUST stay unset in production: it sends every notification to one address.
# FILESHARE_NOTIFICATION_REDIRECT_TO=
