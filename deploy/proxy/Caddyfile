# Reverse proxy for sharekeep.xyz (Architecture.md §7, M8b).
#
# Caddy obtains and renews its own Let's Encrypt certificate over HTTP-01. Cloudflare
# forwards /.well-known/acme-challenge to the origin even while proxying, so this works
# behind the orange cloud — and Cloudflare's SSL mode is Full (strict), meaning the
# origin leg is real TLS rather than the padlock-shaped lie that Flexible mode serves.
#
# X-Forwarded-For: Caddy appends the address it received from (Cloudflare's edge) to the
# header Cloudflare already set with the visitor's address — but ONLY when the request came
# from an address listed in trusted_proxies. Without that list it silently REPLACES the
# header instead, which is what M8c caught: the backend saw a single entry, Cloudflare's
# edge, and recorded that as the visitor on every audited action, while every per-IP limit
# counted the whole world as one visitor. Observed directly, not assumed — with the list,
# `1.2.3.4, 5.6.7.8` arrived intact with the peer appended; without it, only the peer.
#
# The list is generated by deploy/02-firewall.sh from the same Cloudflare ranges the
# firewall admits, so the proxy and the firewall cannot disagree about who Cloudflare is.
# With it the backend sees "<visitor>, <cloudflare edge>" and reads the client two entries
# from the right — FILESHARE_TRUSTED_PROXY_HOPS=2 (Architecture.md §4.4).
{
	email {$CADDY_ACME_EMAIL}
	# Caddy's own admin API is not needed and not exposed.
	admin off
	servers {
		# A missing file makes Caddy refuse to start, which is the right failure: running
		# without it would quietly attribute every request to Cloudflare.
		import /etc/caddy/cloudflare-trusted-proxies.conf
	}
}

(common) {
	encode zstd gzip
	header {
		# The frontend container sends no HSTS of its own (the API does), so the proxy
		# states it for every host it serves.
		Strict-Transport-Security "max-age=31536000; includeSubDomains"
		-Server
	}
}

sharekeep.xyz {
	import common
	reverse_proxy fileshare-frontend:3000
}

api.sharekeep.xyz {
	import common
	reverse_proxy fileshare-backend:8000
}

www.sharekeep.xyz {
	import common
	redir https://sharekeep.xyz{uri} permanent
}
