# Secure File Sharing Platform — environment template (Rules.md §2).
#
# Every variable uses the FILESHARE_ prefix so this project cannot collide with the
# n8n project's AGENCY_-prefixed variables on the shared VPS.
#
# Copy to .env and fill in real values. .env is NEVER committed.

# --- Environment ---
FILESHARE_ENVIRONMENT=local
FILESHARE_LOG_LEVEL=INFO

# --- Postgres (container) ---
FILESHARE_POSTGRES_USER=fileshare
FILESHARE_POSTGRES_PASSWORD=change-me-locally
FILESHARE_POSTGRES_DB=fileshare
FILESHARE_POSTGRES_PORT=5433

# --- Redis (container) ---
FILESHARE_REDIS_PORT=6380

# --- Connection strings (overridden inside Compose to use service names) ---
FILESHARE_DATABASE_URL=postgresql+asyncpg://fileshare:change-me-locally@localhost:5433/fileshare
FILESHARE_REDIS_URL=redis://localhost:6380/0

# --- Auth ---
# Generate with: python -c "import secrets; print(secrets.token_urlsafe(64))"
FILESHARE_JWT_SECRET=generate-a-real-64-byte-secret
# Must be true in staging/production (HTTPS only).
FILESHARE_COOKIE_SECURE=false

# --- Frontend ---
FILESHARE_FRONTEND_ORIGIN=http://localhost:3000
# Baked into the frontend JS bundle at build time, not read at runtime. Changing it
# requires `docker compose build frontend`; a restart alone leaves the old value in
# the bundle and every browser request keeps going to the previous address.
FILESHARE_PUBLIC_API_BASE_URL=http://localhost:8000
FILESHARE_FRONTEND_PORT=3000
FILESHARE_BACKEND_PORT=8000

# --- Supabase Storage ---
# Temporary provider; AWS S3 remains the long-term target (PRD §10).
# Use a NEW, SEPARATE Supabase project - do not reuse the ecommerce-ai-platform one.
# Format: https://<project_ref>.supabase.co
FILESHARE_SUPABASE_URL=
# Bypasses RLS - server-side only, never shipped to the browser.
FILESHARE_SUPABASE_SERVICE_ROLE_KEY=
FILESHARE_SUPABASE_STORAGE_BUCKET=fileshare-files
# MUST match the project's actual region (dashboard -> Project Settings -> General).
# A wrong region fails SigV4 signing as an opaque 403, not a helpful error.
FILESHARE_SUPABASE_REGION=us-east-1
# S3 protocol credentials: Supabase dashboard -> Storage -> Settings -> S3 connection.
# Distinct from the service role key; these sign S3 requests for presigned URLs.
FILESHARE_SUPABASE_S3_ACCESS_KEY_ID=
FILESHARE_SUPABASE_S3_SECRET_ACCESS_KEY=
# Only for self-hosted Supabase or a local MinIO; blank derives from FILESHARE_SUPABASE_URL.
FILESHARE_STORAGE_ENDPOINT_URL=
# Supabase free plan caps a single file at 50MB. Raise on a paid plan.
FILESHARE_MAX_FILE_SIZE_BYTES=52428800

# --- Malware scanning (M4) ---
# Turning this on changes behaviour, not just capability: uploads then land as `pending`
# and CANNOT be downloaded until a scan resolves. With it off they land as
# `scan_skipped` and are downloadable at once. See Architecture.md §3.
FILESHARE_SCANNING_ENABLED=false

# --- VirusTotal (M4) ---
FILESHARE_VIRUSTOTAL_API_KEY=
FILESHARE_VIRUSTOTAL_REQUESTS_PER_MINUTE=4
FILESHARE_VIRUSTOTAL_REQUESTS_PER_DAY=500

# Whether file CONTENT is uploaded to VirusTotal when the hash lookup finds nothing.
# Free-tier submissions are shared with the VirusTotal community, so `true` publishes a
# user's private file to a public analysis pool. Left `false`, unknown files are marked
# "not scanned" with that reason and no bytes leave this infrastructure (Architecture §3b).
FILESHARE_VIRUSTOTAL_SUBMIT_UNKNOWN_FILES=false

# Days a cached verdict stays trusted before the hash is looked up again.
FILESHARE_SCAN_CACHE_TTL_DAYS=30

# --- Resend (M6) ---
FILESHARE_RESEND_API_KEY=
FILESHARE_RESEND_FROM_EMAIL=noreply@example.com

# --- Quotas ---
# 500MB while on Supabase's 1GB free plan, so quota enforcement is actually
# exercised rather than pre-empted by the provider. Returns to 5GB on AWS S3.
FILESHARE_DEFAULT_STORAGE_QUOTA_BYTES=524288000

# --- Deployment (M8) ---
# Name of the reverse proxy's existing Docker network on the shared VPS.
FILESHARE_PROXY_NETWORK=proxy
